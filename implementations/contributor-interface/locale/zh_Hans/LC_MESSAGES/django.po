msgstr "我的论文"

msgid "Task version: %(version)s"
msgstr "任务版本：%(version)s"

msgid "What we ask"
msgstr "我们请您做什么"

msgid "We are building a benchmark that tests whether AI systems can do economics research well. For this paper the team prepared items: deliberate modifications made to build a benchmark task, not claims about the published paper. Please judge whether each item is realistic and consequential, and whether its repair is right."
msgstr "我们正在构建一个评测基准，检验 AI 系统能否胜任经济学研究。团队为这篇论文准备了若干条目：这些是为构建评测任务而有意做出的修改，并非对已发表论文的论断。请判断每个条目是否现实可信、是否有实质性影响，以及其修正是否正确。"

msgid "The prepared items"
msgstr "已准备的条目"

msgid "%(counter)s item"
msgid_plural "%(counter)s items"
msgstr[0] "%(counter)s 个条目"

