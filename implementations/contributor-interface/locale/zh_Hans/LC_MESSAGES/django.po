msgstr "请回答清单中的每一个必填项。"

msgid "Confirm that nothing restricted or confidential is included."
msgstr "请确认其中不包含任何受限或保密的内容。"

msgid "Confirm that you may share the data you include with the project."
msgstr "请确认您有权与本项目共享您所包含的数据。"

msgid "Some answers are incomplete; please check the form."
msgstr "部分回答尚不完整，请检查表单。"

msgid "Please upload one ZIP file (a name ending in .zip)."
msgstr "请上传一个 ZIP 文件（文件名以 .zip 结尾）。"

msgid "This file is not a ZIP archive, so it was not kept."
msgstr "此文件不是 ZIP 压缩包，因此未被保存。"

msgid "The file is empty."
msgstr "文件为空。"

msgid "The file is larger than %(limit)s. Please send it through another channel agreed with the team."
msgstr "文件大于 %(limit)s。请通过与团队商定的其他渠道发送。"

msgid "There are already many uploads for this paper. Please remove one you no longer need."
msgstr "这篇论文的上传已经很多。请删除一个您不再需要的上传。"

msgid "An unfinished upload of this file exists. Finish it with the upload button (with JavaScript on), or remove it."
msgstr "此文件有一个未完成的上传。请使用上传按钮（需开启 JavaScript）完成它，或将其删除。"

msgid "This file belongs to a submitted version and stays with the team."
msgstr "此文件属于一个已提交的版本，将由团队保留。"

msgid "This file is still being checked. Please wait a moment."
msgstr "此文件仍在核验中，请稍候。"

msgid "The upload could not continue. Please try again."
msgstr "上传无法继续，请重试。"

msgid "These answers were saved from another tab after you opened this page. The saved answers are shown below; please make your change again."
msgstr "在您打开此页面之后，这些回答已在另一个标签页中被保存。下方显示的是已保存的回答；请重新进行您的修改。"

msgid "Submitted: version %(n)s. Thank you. You can still change your answers and submit again."
msgstr "已提交：第 %(n)s 版。谢谢。您仍可修改回答并再次提交。"

msgid "Saved. Nothing is sent to the team until you submit."
msgstr "已保存。在您提交之前，不会向团队发送任何内容。"

