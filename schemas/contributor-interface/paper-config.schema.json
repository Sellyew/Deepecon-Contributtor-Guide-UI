{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepecon.example/schemas/contributor-interface/paper-config/0.1.0",
  "title": "Paper configuration",
  "description": "One configured paper and task version for the contributor interface: what contributors see and what the team asks them to provide.",
  "type": "object",
  "required": ["schema_version", "paper_id", "citation", "task_version", "rubric_version", "group_targets", "visible_item_fields", "materials_checklist"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "paper_id": {"$ref": "#/$defs/id"},
    "citation": {
      "type": "object",
      "required": ["authors", "title", "journal", "year"],
      "properties": {
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "title": {"type": "string", "minLength": 1},
        "journal": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "volume": {"type": "string"},
        "issue": {"type": "string"},
        "pages": {"type": "string"},
        "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"}
      },
      "additionalProperties": false
    },
    "replication_package": {"$ref": "#/$defs/publicReference", "description": "The public replication package the team already holds, if any."},
    "task_version": {"type": "string", "minLength": 1, "description": "For example V5."},
    "rubric_version": {"type": "string", "minLength": 1, "description": "Must equal the version of the imported rubric."},
    "candidate_version": {"type": "string"},
    "candidate_package_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_package_visible_to_contributors": {"type": "boolean", "default": false, "description": "Whether the assigned contributor may download the agent-facing package (question Q5)."},
    "group_targets": {
      "type": "object",
      "required": ["conceptual", "missing", "technical"],
      "properties": {
        "conceptual": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "technical": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false,
      "description": "Planning targets shown to contributors; never quotas."
    },
    "visible_item_fields": {
      "type": "object",
      "required": ["conceptual", "missing", "technical"],
      "properties": {
        "conceptual": {"$ref": "#/$defs/fieldList"},
        "missing": {"$ref": "#/$defs/fieldList"},
        "technical": {"$ref": "#/$defs/fieldList"}
      },
      "additionalProperties": false,
      "description": "Item fields shown to contributors (question Q1). Every other field stays hidden."
    },
    "item_display_text": {
      "type": "object",
      "description": "Human-written display text per item ID and language (question Q6). No machine translation by default.",
      "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,16}$"},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"enum": ["en", "zh-Hans"]},
        "additionalProperties": {
          "type": "object",
          "required": ["title", "translated_by"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "description": {"type": "string"},
            "translated_by": {"type": "string", "minLength": 1},
            "machine_translated": {"const": false}
          },
          "additionalProperties": false
        }
      }
    },
    "file_name_map": {
      "type": "array",
      "description": "Optional map from candidate file names to the author's original file names (question Q2).",
      "items": {
        "type": "object",
        "required": ["candidate_path", "original_path"],
        "properties": {"candidate_path": {"type": "string", "minLength": 1}, "original_path": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "paired_variants": {
      "type": "array",
      "description": "Key points for which the team prepared both an error and a missing version, shown side by side (question Q3).",
      "items": {
        "type": "object",
        "required": ["key_point_id", "item_ids"],
        "properties": {
          "key_point_id": {"$ref": "#/$defs/id"},
          "item_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "materials_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "requirement"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "label": {"$ref": "#/$defs/bilingualText"},
          "help": {"$ref": "#/$defs/bilingualText"},
          "requirement": {"enum": ["required", "optional", "confirm_existing", "not_needed"]}
        },
        "additionalProperties": false
      }
    },
    "languages": {"type": "array", "items": {"enum": ["en", "zh-Hans"]}, "uniqueItems": true, "default": ["en", "zh-Hans"]}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fieldList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["id", "title", "files", "file", "criterion", "available_evidence_and_boundary", "acceptable_work", "repair", "critical_requirements", "points", "allowed_scores", "tiers", "scoring_method", "evidence_record_required"]}
    },
    "bilingualText": {
      "type": "object",
      "required": ["en"],
      "properties": {"en": {"type": "string", "minLength": 1}, "zh-Hans": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "publicReference": {
      "type": "object",
      "required": ["repository", "identifier", "version"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "description": "For example openICPSR."},
        "identifier": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"}
      },
      "additionalProperties": false
    }
  }
}
