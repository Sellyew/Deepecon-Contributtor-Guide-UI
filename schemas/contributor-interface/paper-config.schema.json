{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepecon.example/schemas/contributor-interface/paper-config/0.3.0",
  "title": "Paper configuration",
  "description": "One configured paper and task version: categories (which vary by field), what contributors see, the original-file-name map built by the team, the materials checklist, and submission settings. Interface text in this file (category labels and meanings, checklist entries) is localized; item text from the rubric is shown in its original language and is not translated (D-030).",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "citation",
    "task_version",
    "rubric_version",
    "categories",
    "materials_checklist"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "field": {
      "type": "string",
      "description": "Free label of the field template, e.g. empirical-micro, theory, macro-quantitative."
    },
    "citation": {
      "type": "object",
      "required": [
        "authors",
        "title",
        "journal",
        "year"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "journal": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "volume": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        }
      },
      "additionalProperties": false
    },
    "replication_package": {
      "type": "object",
      "required": [
        "repository",
        "identifier",
        "version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "For example openICPSR, Dataverse, Zenodo."
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        }
      },
      "additionalProperties": false,
      "description": "The public replication package, if one exists."
    },
    "task_version": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
      "description": "Part of a file name in private storage: letters, digits, '.', '_' and '-' only."
    },
    "candidate_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_package_visible_to_contributors": {
      "type": "boolean",
      "default": true,
      "description": "The assigned contributor may download the agent-facing package (D-028)."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "file_name_map": {
      "type": "array",
      "description": "Built by the team from the contributor's original file names (D-026).",
      "items": {
        "type": "object",
        "required": [
          "candidate_path",
          "original_path"
        ],
        "properties": {
          "candidate_path": {
            "type": "string",
            "minLength": 1
          },
          "original_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "materials_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "label": {
            "$ref": "#/$defs/localizedText"
          },
          "help": {
            "$ref": "#/$defs/localizedText"
          },
          "requirement": {
            "enum": [
              "required",
              "optional",
              "confirm_existing",
              "not_needed"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "submission": {
      "type": "object",
      "properties": {
        "runnable_package_required": {
          "type": "boolean",
          "default": true
        },
        "max_upload_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "accepted_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "upload",
              "public_reference",
              "other_agreed"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "description": "Interface languages offered; the first is the default. English and Simplified Chinese at launch; a language is added with a reviewed interface catalogue."
    },
    "publication_status": {
      "$ref": "#/$defs/publicationStatus"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "category": {
      "type": "object",
      "required": [
        "id",
        "source_array",
        "label",
        "summary",
        "field_roles",
        "visible_roles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "source_array": {
          "type": "string",
          "minLength": 1,
          "description": "Key of the item array in the team's rubric file (V5: conceptual, missing, technical)."
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "summary": {
          "$ref": "#/$defs/localizedText",
          "description": "One line telling contributors what this category means."
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "description": "Planning target, never a quota."
        },
        "location_kind": {
          "enum": [
            "code",
            "paper",
            "data",
            "mixed"
          ]
        },
        "field_roles": {
          "type": "object",
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "points": {
              "type": "string",
              "minLength": 1
            },
            "locations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "acceptable_answer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "critical_requirements": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "description": "Which fields of the team's rubric items fill each display role. Fields not named here are never shown."
        },
        "visible_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "title",
              "summary",
              "locations",
              "change",
              "description",
              "acceptable_answer",
              "critical_requirements",
              "affected_results",
              "consequence",
              "weight"
            ]
          },
          "description": "Roles shown to contributors. summary, change, affected_results and consequence come from the item map; weight is the item's points."
        }
      },
      "additionalProperties": false
    },
    "localizedText": {
      "type": "object",
      "required": [
        "en"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Interface text keyed by BCP 47 language tag (en required; zh-Hans at launch; more languages can be added)."
    },
    "publicationStatus": {
      "type": "object",
      "description": "Rule 8 (D-040): a scored task keeps its answers unpublished until retired; a demo or development task may be published and is not scored. The research lead designates demo or development tasks, with the date, before any evaluation run. Without this field the site treats the task as scored.",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "scored",
            "demo_or_development"
          ]
        },
        "designated_on": {
          "type": "string",
          "format": "date"
        },
        "designated_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "demo_or_development"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "designated_on"
        ]
      }
    }
  }
}
