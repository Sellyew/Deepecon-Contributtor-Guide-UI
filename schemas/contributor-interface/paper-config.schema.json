{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepecon.example/schemas/contributor-interface/paper-config/0.2.0",
  "title": "Paper configuration",
  "description": "One configured paper and task version: categories (which vary by field), what contributors see, translations with provenance, the original-file-name map built by the team, the materials checklist, and submission settings.",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "citation",
    "task_version",
    "rubric_version",
    "categories",
    "materials_checklist"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "field": {
      "type": "string",
      "description": "Free label of the field template, e.g. empirical-micro, theory, macro-quantitative."
    },
    "citation": {
      "type": "object",
      "required": [
        "authors",
        "title",
        "journal",
        "year"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "journal": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "volume": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "pages": {
          "type": "string"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        }
      },
      "additionalProperties": false
    },
    "replication_package": {
      "type": "object",
      "required": [
        "repository",
        "identifier",
        "version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "For example openICPSR, Dataverse, Zenodo."
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        }
      },
      "additionalProperties": false,
      "description": "The public replication package, if one exists."
    },
    "task_version": {
      "type": "string",
      "minLength": 1
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_version": {
      "type": "string"
    },
    "candidate_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_package_visible_to_contributors": {
      "type": "boolean",
      "default": true,
      "description": "The assigned contributor may download the agent-facing package (D-028)."
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "translations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,16}$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "en",
            "zh-Hans"
          ]
        },
        "additionalProperties": {
          "$ref": "#/$defs/translation"
        }
      }
    },
    "file_name_map": {
      "type": "array",
      "description": "Built by the team from the contributor's original file names (D-026).",
      "items": {
        "type": "object",
        "required": [
          "candidate_path",
          "original_path"
        ],
        "properties": {
          "candidate_path": {
            "type": "string",
            "minLength": 1
          },
          "original_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "materials_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "label": {
            "type": "object",
            "required": [
              "en"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "help": {
            "type": "object",
            "required": [
              "en"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "requirement": {
            "enum": [
              "required",
              "optional",
              "confirm_existing",
              "not_needed"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "submission": {
      "type": "object",
      "properties": {
        "runnable_package_required": {
          "type": "boolean",
          "default": true
        },
        "max_upload_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "accepted_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "upload",
              "public_reference",
              "other_agreed"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "en",
          "zh-Hans"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "category": {
      "type": "object",
      "required": [
        "id",
        "source_array",
        "label",
        "summary",
        "field_roles",
        "visible_roles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
        },
        "source_array": {
          "type": "string",
          "minLength": 1,
          "description": "Key of the item array in the team's rubric file (V5: conceptual, missing, technical)."
        },
        "label": {
          "type": "object",
          "required": [
            "en"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "required": [
            "en"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "zh-Hans": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "description": "One line telling contributors what this category means."
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "description": "Planning target, never a quota."
        },
        "location_kind": {
          "enum": [
            "code",
            "paper",
            "data",
            "mixed"
          ]
        },
        "field_roles": {
          "type": "object",
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "points": {
              "type": "string",
              "minLength": 1
            },
            "locations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "acceptable_answer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "critical_requirements": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "description": "Which fields of the team's rubric items fill each display role. Fields not named here are never shown."
        },
        "visible_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "title",
              "summary",
              "locations",
              "change",
              "description",
              "acceptable_answer",
              "critical_requirements",
              "affected_results",
              "consequence",
              "weight"
            ]
          },
          "description": "Roles shown to contributors. summary, change, affected_results and consequence come from the item map; weight is the item's points."
        }
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": [
        "title",
        "method"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "method": {
          "enum": [
            "llm",
            "human"
          ]
        },
        "model": {
          "type": "object",
          "required": [
            "name",
            "mode"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "local",
                "external_api"
              ],
              "description": "local: a model on project hardware (no third party). external_api: a provider's API (data leave the project; needs the research lead's explicit configuration)."
            }
          },
          "additionalProperties": false
        },
        "translated_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "llm"
              }
            }
          },
          "then": {
            "required": [
              "model"
            ]
          }
        }
      ],
      "description": "Contributors see a translation only after a team member has reviewed it (reviewed_by and reviewed_at present); it is labelled with its method."
    }
  }
}
