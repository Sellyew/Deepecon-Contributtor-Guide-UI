{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepecon.example/schemas/contributor-interface/submission-manifest/0.1.0",
  "title": "Submission manifest",
  "description": "What a contributor provided for one paper: uploaded files with SHA-256 (the convention of the V5 package's SHA256.json), or a public reference, or another agreed channel; which checklist entries are covered; and the declaration that no data are included.",
  "type": "object",
  "required": ["schema_version", "paper_id", "assignment_id", "channel", "checklist_coverage", "no_data_declaration", "created_at"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "paper_id": {"$ref": "#/$defs/id"},
    "assignment_id": {"$ref": "#/$defs/id"},
    "channel": {"enum": ["upload", "public_reference", "other_agreed"]},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "public_reference": {
      "type": "object",
      "required": ["repository", "identifier", "version"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"}
      },
      "additionalProperties": false
    },
    "other_channel_note": {"type": "string", "minLength": 1},
    "checklist_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checklist_id", "status"],
        "properties": {
          "checklist_id": {"$ref": "#/$defs/id"},
          "status": {"enum": ["provided", "in_public_package", "not_available", "not_applicable"]},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "no_data_declaration": {"const": true, "description": "The contributor confirms that no raw, restricted, or derived data are included."},
    "created_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "verification_status": {"enum": ["pending", "verified", "mismatch"], "default": "pending"},
    "verified_by": {"type": "string"}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"channel": {"const": "upload"}}}, "then": {"required": ["files"], "properties": {"files": {"minItems": 1}}}},
    {"if": {"properties": {"channel": {"const": "public_reference"}}}, "then": {"required": ["public_reference"]}},
    {"if": {"properties": {"channel": {"const": "other_agreed"}}}, "then": {"required": ["other_channel_note"]}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
