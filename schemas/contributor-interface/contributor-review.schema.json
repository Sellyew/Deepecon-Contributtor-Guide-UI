{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepecon.example/schemas/contributor-interface/contributor-review/0.3.0",
  "title": "Contributor review (export)",
  "description": "One contributor's answers on one paper's prepared items (categories as configured for the paper), as exported by the administrator. Identifies the contributor only by a pseudonymous ID; contains no invitation credentials (unknown fields are rejected).",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "assignment_id",
    "contributor_id",
    "relationship_to_paper",
    "language",
    "rubric_version",
    "reviews",
    "proposals",
    "confirmations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "paper_id": {
      "$ref": "#/$defs/id"
    },
    "assignment_id": {
      "$ref": "#/$defs/id"
    },
    "contributor_id": {
      "$ref": "#/$defs/id"
    },
    "relationship_to_paper": {
      "enum": [
        "author",
        "invited_expert"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "Interface language the contributor used; their answers are stored as written."
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "candidate_version": {
      "type": "string"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemReview"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "confirmed_at",
          "content_sha256"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hash of the reviews and proposals as confirmed."
          }
        },
        "additionalProperties": false
      }
    },
    "frozen": {
      "type": "boolean",
      "default": false
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "messages": {
      "type": "array",
      "description": "Questions to the team and the team's answers (Ask the team); no AI involved.",
      "items": {
        "type": "object",
        "required": [
          "message_id",
          "author",
          "text",
          "created_at"
        ],
        "properties": {
          "message_id": {
            "$ref": "#/$defs/id"
          },
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,16}$"
          },
          "author": {
            "enum": [
              "contributor",
              "team"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "consent": {
      "$ref": "#/$defs/consent"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "triState": {
      "enum": [
        "yes",
        "no",
        "unsure"
      ]
    },
    "itemReview": {
      "type": "object",
      "required": [
        "item_id",
        "category",
        "verdict",
        "updated_at"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,16}$"
        },
        "category": {
          "$ref": "#/$defs/id"
        },
        "verdict": {
          "enum": [
            "keep",
            "keep_with_changes",
            "reject",
            "unsure",
            "not_reviewed"
          ]
        },
        "checks": {
          "type": "object",
          "properties": {
            "realistic": {
              "$ref": "#/$defs/triState"
            },
            "consequential": {
              "$ref": "#/$defs/triState"
            },
            "repair_correct": {
              "$ref": "#/$defs/triState"
            }
          },
          "additionalProperties": false
        },
        "reject_reason": {
          "enum": [
            "not_realistic",
            "not_consequential",
            "repair_or_acceptable_work_wrong",
            "other"
          ]
        },
        "variant_choice": {
          "enum": [
            "first",
            "second",
            "both",
            "neither"
          ],
          "description": "Only for items shown as a paired error/missing key point."
        },
        "suggested_title": {
          "type": "string",
          "minLength": 1
        },
        "suggested_description": {
          "type": "string",
          "minLength": 1
        },
        "other_valid_repairs": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "ai_help": {
          "$ref": "#/$defs/aiHelp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "verdict": {
                  "const": "reject"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reject_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "keep_with_changes"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "suggested_title"
                ]
              },
              {
                "required": [
                  "suggested_description"
                ]
              },
              {
                "required": [
                  "other_valid_repairs"
                ]
              },
              {
                "required": [
                  "comment"
                ]
              }
            ]
          }
        }
      ]
    },
    "proposal": {
      "type": "object",
      "required": [
        "proposal_id",
        "category",
        "description",
        "created_at"
      ],
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/id"
        },
        "location": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string"
        },
        "suggested_repair": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "const": "unsure"
            }
          ],
          "description": "A category ID from the paper configuration, or unsure."
        },
        "ai_help": {
          "$ref": "#/$defs/aiHelp"
        }
      },
      "additionalProperties": false
    },
    "aiHelp": {
      "type": "object",
      "description": "The contributor's own report of AI help with this answer or proposal (D-039). Self-reported, so probably undercounted; used to report AI-assisted and unassisted validations separately and, when the items or package were entered, to fill the task's exposure log (D-040).",
      "required": [
        "used"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "account_kind": {
          "enum": [
            "work",
            "personal",
            "api",
            "unknown"
          ]
        },
        "entered_items_or_package": {
          "type": "boolean",
          "description": "Whether the items or the task package were put into the AI tool."
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "used": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "used",
          "tool",
          "entered_items_or_package"
        ]
      }
    },
    "consent": {
      "type": "object",
      "description": "The contributor's choices on the notice screen (D-042), recorded with their date; a later change creates a new record in the site, and the export carries the latest.",
      "required": [
        "evaluation_through_apis_acknowledged",
        "team_ai_use_of_unpublished_material",
        "recorded_at"
      ],
      "properties": {
        "evaluation_through_apis_acknowledged": {
          "const": true,
          "description": "The contributor was told that the finished task is sent through their APIs to each AI company whose models are evaluated, which receives it and may keep it."
        },
        "team_ai_use_of_unpublished_material": {
          "type": "boolean",
          "description": "Whether the team may use AI services with the contributor's unpublished materials and responses."
        },
        "notice_version": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
